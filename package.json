{
  "name": "civicshot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "dev:server": "node --watch src/server/main.ts",
    "dev:client": "vite --port ${E2E_PORT:-8871} --strictPort --host localhost",
    "dev": "concurrently -k -n server,client \"npm run dev:server\" \"npm run dev:client\"",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit --passWithNoTests",
    "e2e": "npx playwright test && npx playwright test -c playwright.pwa.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "compressorjs": "^1.4.0",
    "exifr": "^7.1.3",
    "h3-js": "^4.5.0",
    "hono": "^4.13.17",
    "idb": "^8.0.4",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^11.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/leaflet": "^1.9.22",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "mailparser": "^3.14.2",
    "mapshaper": "^0.7.101",
    "smtp-server": "^3.21.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
